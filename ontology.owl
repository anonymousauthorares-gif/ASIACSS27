  </owl:Class>

  <!-- ===== Contramedidas (funções) ===== -->
  <owl:Class rdf:about="&tinilau;TL_Preventive_Countermeasure">
    <rdfs:label>TL_Preventive_Countermeasure</rdfs:label>
