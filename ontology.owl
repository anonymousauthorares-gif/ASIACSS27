    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Family_Type">
    <rdfs:label>TL_Family_Type</rdfs:label>
    <rdfs:comment>Categoria taxonômica de Família.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_SubFamily_Type">
    <rdfs:label>TL_SubFamily_Type</rdfs:label>
    <rdfs:comment>Categoria taxonômica de Subfamília.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Genus_Type">
    <rdfs:label>TL_Genus_Type</rdfs:label>
    <rdfs:comment>Categoria taxonômica de Gênero.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Species_Type">
    <rdfs:label>TL_Species_Type</rdfs:label>
    <rdfs:comment>Categoria taxonômica de Espécie.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <!-- Partes biológicas -->
  <owl:Class rdf:about="&tinilau;TL_Biological_Part_Type">
    <rdfs:label>TL_Biological_Part_Type</rdfs:label>
    <rdfs:comment>Categoria de partes biológicas (ex.: tecido, órgão, nadadeira).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <!-- Tipos de animais marinhos -->
  <owl:Class rdf:about="&tinilau;TL_Marine_Animal_Type">
    <rdfs:label>TL_Marine_Animal_Type</rdfs:label>
    <rdfs:comment>Categoria de animais marinhos (peixes, cetáceos, crustáceos etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <!-- Tipo de dado científico (ex.: série temporal oceanográfica, metadado de observação) -->
  <owl:Class rdf:about="&tinilau;TL_Scientific_Data_Type">
    <rdfs:label>TL_Scientific_Data_Type</rdfs:label>
    <rdfs:comment>Categoria para dados científicos e seus conjuntos (p.ex., séries temporais, grades, metadados experimentais).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Tipo de objeto digital (classifica instâncias de TL_Digital_Object) -->
  <owl:Class rdf:about="&tinilau;TL_Digital_Object_Type">
    <rdfs:label>TL_Digital_Object_Type</rdfs:label>
    <rdfs:comment>Categoria para objetos digitais (arquivo raster, vetor, vídeo, log, pacote de software, etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Tipo visual (classifica conteúdos visuais como mapas, imagens, diagramas) -->
  <owl:Class rdf:about="&tinilau;TL_Visual_Type">
    <rdfs:label>TL_Visual_Type</rdfs:label>
    <rdfs:comment>Categoria para representações visuais (mapa temático, ortoimagem, diagrama, esquema).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Tipo de linguagem (sistemas linguísticos ou formais) -->
  <owl:Class rdf:about="&tinilau;TL_Language_Type">
    <rdfs:label>TL_Language_Type</rdfs:label>
    <rdfs:comment>Categoria para línguas naturais e linguagens formais (pt-BR, en, WKT, GeoJSON, SQL, RDF).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Proposição -->
  <owl:Class rdf:about="&tinilau;TL_Proposition_Type">
    <rdfs:label>TL_Proposition_Type</rdfs:label>
    <rdfs:comment>Afirmação ou enunciado que pode ser avaliado como verdadeiro ou falso.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Appellation (denominação, nome atribuído a algo) -->
  <owl:Class rdf:about="&tinilau;TL_Appellation_Type">
    <rdfs:label>TL_Appellation_Type</rdfs:label>
    <rdfs:comment>Denominação atribuída a uma entidade, como um nome ou código identificador.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Unidade de medida -->
  <owl:Class rdf:about="&tinilau;TL_Measurement_Unit_Type">
    <rdfs:label>TL_Measurement_Unit_Type</rdfs:label>
    <rdfs:comment>Unidade de medida padronizada (ex.: metro, segundo, tonelada).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Indicador estatístico -->
  <owl:Class rdf:about="&tinilau;TL_Statistic_Indicator_Type">
    <rdfs:label>TL_Statistic_Indicator_Type</rdfs:label>
    <rdfs:comment>Indicador derivado de estatísticas agregadas (ex.: taxa de captura por unidade de esforço).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Design ou procedimento -->
  <owl:Class rdf:about="&tinilau;TL_Design_or_Procedure_Type">
    <rdfs:label>TL_Design_or_Procedure_Type</rdfs:label>
    <rdfs:comment>Esquema, plano ou método que orienta como executar uma atividade ou processo.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- S-100 product family -->
  <owl:Class rdf:about="&tinilau;TL_S100_Product">
    <rdfs:label>TL_S100_Product</rdfs:label>
    <rdfs:comment>Família de produtos IHO S-100 para e-navigation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Scientific_Data_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_S101_ENC">
    <rdfs:label>TL_S101_ENC</rdfs:label>
    <rdfs:comment>Electronic Navigational Chart (S-101).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_S100_Product"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_S102_Bathymetric_Surface">
    <rdfs:label>TL_S102_Bathymetric_Surface</rdfs:label>
    <rdfs:comment>Superfícies batimétricas (S-102).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_S100_Product"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_S104_Water_Level">
    <rdfs:label>TL_S104_Water_Level</rdfs:label>
    <rdfs:comment>Nível d’água e maré (S-104).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_S100_Product"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_S111_Surface_Currents">
    <rdfs:label>TL_S111_Surface_Currents</rdfs:label>
    <rdfs:comment>Correntes de superfície (S-111).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_S100_Product"/>
  </owl:Class>


  <!--
    Subclasses de TL_InformationResource: cada uma para um tipo de recurso.
  -->

  <owl:Class rdf:about="&tinilau;TL_ContentCollection">
    <rdfs:label>TL_ContentCollection</rdfs:label>
    <rdfs:comment>Coleção de conteúdos digitais (banco de dados, corpora).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_NormativeArtifact">
    <rdfs:label>TL_NormativeArtifact</rdfs:label>
    <rdfs:comment>Artefato normativo: documento legal ou regulatório.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!--
    Subclasses de TL_PhysicalEntity: lugar, artefato e agente.
  -->
  <owl:Class rdf:about="&tinilau;TL_Place">
    <rdfs:label>TL_Place</rdfs:label>
    <rdfs:comment>Lugar físico: porto, área marítima, terminal.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- ===== Cadeia: Objeto físico / Biológico ===== -->

  <!-- Objeto físico discreto (indivíduo ou artefato natural) -->
  <owl:Class rdf:about="&tinilau;TL_Physical_Object">
    <rdfs:label>TL_Physical_Object</rdfs:label>
    <rdfs:comment>Entidade física individual e discreta (natural ou construída).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- Objeto biológico (organismo ou parte de organismo) -->
  <owl:Class rdf:about="&tinilau;TL_Biological_Object">
    <rdfs:label>TL_Biological_Object</rdfs:label>
    <rdfs:comment>Organismo, parte de organismo ou material biológico reconhecido como objeto físico.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Physical_Object"/>
  </owl:Class>

  <!-- Elemento biótico (componente vivo do ambiente) -->
  <owl:Class rdf:about="&tinilau;TL_Biotic_Element">
    <rdfs:label>TL_Biotic_Element</rdfs:label>
    <rdfs:comment>Componente vivo do ambiente (espécies, populações, indivíduos).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biological_Object"/>
  </owl:Class>

  <!-- Animal marinho (especialização de elemento biótico) -->
  <owl:Class rdf:about="&tinilau;TL_Marine_Animal">
    <rdfs:label>TL_Marine_Animal</rdfs:label>
    <rdfs:comment>Organismo animal com ciclo de vida predominantemente marinho.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element"/>
  </owl:Class>

  <!-- Espécime (amostra física de um objeto biológico) -->
  <owl:Class rdf:about="&tinilau;TL_Specimen">
    <rdfs:label>TL_Specimen</rdfs:label>
    <rdfs:comment>Exemplar físico utilizado como amostra ou referência de um objeto biológico.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biological_Object"/>
  </owl:Class>

  <!-- ===== Lugares físicos ===== -->
  <!-- Área de água (mar, baía, zona marítima, etc.) -->
  <owl:Class rdf:about="&tinilau;TL_Water_Area">
    <rdfs:label>TL_Water_Area</rdfs:label>
    <rdfs:comment>Tipo de lugar físico constituído predominantemente por massas de água (mar, baía, bacia, zona costeira).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Place"/>
  </owl:Class>

  <!-- ===== Entidades físicas ===== -->
  <!-- Elemento abiótico (não vivo) do ambiente -->
  <owl:Class rdf:about="&tinilau;TL_Abiotic_Element">
    <rdfs:label>TL_Abiotic_Element</rdfs:label>
    <rdfs:comment>Componente físico não vivo do ambiente (ex.: rocha, recife rochoso, banco de areia, gelo marinho).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- (Opcional) Objeto natural explícito -->
  <owl:Class rdf:about="&tinilau;TL_Natural_Object">
    <rdfs:label>TL_Natural_Object</rdfs:label>
    <rdfs:comment>Objeto físico de origem natural, distinto de artefatos.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

 <!-- TINILAU: Declarative Place -->
  <owl:Class rdf:about="&tinilau;TL_Declarative_Place">
    <rdfs:label xml:lang="en">TL_Declarative_Place</rdfs:label>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Place"/>
    <rdfs:comment xml:lang="en">
        A place whose extent/position is declared by a geometric or textual expression
        (e.g., polygon, bounding box, coordinate list).
    </rdfs:comment>
  <rdfs:isDefinedBy rdf:resource="https://w3id.org/tinilau/ont"/>
  </owl:Class>


<owl:Class rdf:about="&tinilau;TL_Artifact">
  <rdfs:label>TL_Artifact</rdfs:label>
  <rdfs:comment>Artefato físico: embarcação, sensor, equipamento.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_ManMade_Thing"/>
</owl:Class>

<!-- Dispositivo digital: subclass de TL_Artifact -->
<owl:Class rdf:about="&tinilau;TL_Digital_Device">
  <rdfs:label>TL_Digital_Device</rdfs:label>
  <rdfs:comment>
    Dispositivo físico eletrônico usado para processar, armazenar ou transmitir informação digital
    (por exemplo, computador de bordo, AIS transponder, boia inteligente).
  </rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Artifact"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_ECDIS_System">
  <rdfs:label>TL_ECDIS_System</rdfs:label>
  <rdfs:comment>ECDIS a bordo (cartas S-101/S-100).</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Device"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_GNSS_Receiver">
  <rdfs:label>TL_GNSS_Receiver</rdfs:label>
  <rdfs:comment>Receptor GNSS (GPS/Galileo/GLONASS).</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Device"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_AIS_Transceiver">
  <rdfs:label>TL_AIS_Transceiver</rdfs:label>
  <rdfs:comment>Transceptor AIS classe A/B ou base.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Device"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_Marine_Radar">
  <rdfs:label>TL_Marine_Radar</rdfs:label>
  <rdfs:comment>Radar de navegação/ARPA.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Device"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_Satcom_Terminal">
  <rdfs:label>TL_Satcom_Terminal</rdfs:label>
  <rdfs:comment>Terminal satcom (Inmarsat/VSAT etc.).</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Device"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_Shipboard_Data_Server">
  <rdfs:label>TL_Shipboard_Data_Server</rdfs:label>
  <rdfs:comment>Servidor de dados embarcado conforme ISO 19847.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Device"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_Shipboard_Data_Model">
  <rdfs:label>TL_Shipboard_Data_Model</rdfs:label>
  <rdfs:comment>Modelo conceitual/ontologia de dados de máquinas (ISO 19848).</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_Machinery_Data_Record">
  <rdfs:label>TL_Machinery_Data_Record</rdfs:label>
  <rdfs:comment>Registro digital de sensor/sistema de máquinas (amostra de dados embarcados).</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Object"/>
</owl:Class>


  <owl:Class rdf:about="&tinilau;TL_Agent">
    <rdfs:label>TL_Agent</rdfs:label>
    <rdfs:comment>Agente (humano ou organização).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- Especializações de TL_Agent -->
  <owl:Class rdf:about="&tinilau;TL_Person">
    <rdfs:label>TL_Person</rdfs:label>
    <rdfs:comment>Indivíduo humano que atua como agente (capitão, inspetor, pesquisador etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Agent"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Organization">
    <rdfs:label>TL_Organization</rdfs:label>
    <rdfs:comment>Entidade formal com identidade própria (empresa, autoridade portuária, ONG, universidade).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Agent"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Group">
    <rdfs:label>TL_Group</rdfs:label>
    <rdfs:comment>Coletivo não necessariamente formal (equipe de inspeção, grupo de pesquisa, tripulação).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Agent"/>
  </owl:Class>

  <!-- Coisas produzidas pela ação humana -->
  <owl:Class rdf:about="&tinilau;TL_ManMade_Thing">
    <rdfs:label>TL_ManMade_Thing</rdfs:label>
    <rdfs:comment>Objeto ou estrutura criada intencionalmente por agentes humanos.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- Estoque populacional -->
  <owl:Class rdf:about="&tinilau;TL_Stock">
    <rdfs:label>TL_Stock</rdfs:label>
    <rdfs:comment>Conjunto de indivíduos que constitui uma população ou estoque reconhecível.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- Quantidade de matéria -->
  <owl:Class rdf:about="&tinilau;TL_Amount_of_Matter">
    <rdfs:label>TL_Amount_of_Matter</rdfs:label>
    <rdfs:comment>Porção de material ou substância, não individualizada em agentes ou artefatos.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <!-- (Opcional) propriedades de membresia -->
  <owl:ObjectProperty rdf:about="&tinilau;hasMember">
    <rdfs:label>hasMember</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Agent"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Agent"/>
    <rdfs:comment>Relação de composição entre agentes (organizações/grupos e seus membros).</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;memberOf">
    <rdfs:label>memberOf</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Agent"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Agent"/>
    <owl:inverseOf rdf:resource="&tinilau;hasMember"/>
  </owl:ObjectProperty>

  <owl:Class rdf:about="&tinilau;TL_Ecosystem">
    <rdfs:label>TL_Ecosystem</rdfs:label>
    <rdfs:comment>
      Sistema ecológico composto por organismos, habitats e suas interações,
      com extensão espacial identificável.
    </rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Cargo">
    <rdfs:label>TL_Cargo</rdfs:label>
    <rdfs:comment>Conteúdo/mercadoria movimentada em operações portuárias.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Amount_of_Matter"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Containerized_Cargo">
    <rdfs:label>TL_Containerized_Cargo</rdfs:label>
    <rdfs:comment>Carga conteinerizada.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cargo"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Dry_Bulk_Cargo">
    <rdfs:label>TL_Dry_Bulk_Cargo</rdfs:label>
    <rdfs:comment>Granel sólido (minério, grãos etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cargo"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Liquid_Bulk_Cargo">
    <rdfs:label>TL_Liquid_Bulk_Cargo</rdfs:label>
    <rdfs:comment>Granel líquido (óleo, químicos).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cargo"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Break_Bulk_Cargo">
    <rdfs:label>TL_Break_Bulk_Cargo</rdfs:label>
    <rdfs:comment>Carga geral/solta (peças, big bags etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cargo"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_RoRo_Cargo">
    <rdfs:label>TL_RoRo_Cargo</rdfs:label>
    <rdfs:comment>Veículos/ro-ro.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cargo"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Dangerous_Cargo">
    <rdfs:label>TL_Dangerous_Cargo</rdfs:label>
    <rdfs:comment>Carga perigosa conforme IMDG Code.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cargo"/>
  </owl:Class>

  <!--
    Subclasses de TL_Process: eventos, atividades, medições.
  -->
  <owl:Class rdf:about="&tinilau;TL_Event">
    <rdfs:label>TL_Event</rdfs:label>
    <rdfs:comment>Evento (ocorrência pontual no tempo).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Process"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Activity">
    <rdfs:label>TL_Activity</rdfs:label>
    <rdfs:comment>Atividade (processo com duração).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Process"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Measurement">
    <rdfs:label>TL_Measurement</rdfs:label>
    <rdfs:comment>Medição: processo de coleta de um valor ou observação.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Observation"/>
  </owl:Class>

  <!-- ============================================================= -->
  <!-- TINILAU — especializações de TL_Process                      -->
  <!-- ============================================================= -->

  <!-- Atividade genérica de atribuição de atributos/relacionamentos -->
  <owl:Class rdf:about="&tinilau;TL_Attribute_Assignment">
    <rdfs:label>TL_Attribute_Assignment</rdfs:label>
    <rdfs:comment>Atividade que registra uma afirmação sobre atributo ou relação de uma entidade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Activity"/>
  </owl:Class>

  <!-- Observação científica (medições/testemunho de estados/ocorrências) -->
  <owl:Class rdf:about="&tinilau;TL_Observation">
    <rdfs:label>TL_Observation</rdfs:label>
    <rdfs:comment>Observação de estados, comportamentos ou ocorrências em dado tempo e lugar.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attribute_Assignment"/>
  </owl:Class>

  <!-- Evento de encontro/detecção durante uma observação -->
  <owl:Class rdf:about="&tinilau;TL_Encounter_Event">
    <rdfs:label>TL_Encounter_Event</rdfs:label>
    <rdfs:comment>Ocorrência em que algo é encontrado/detectado no curso de uma observação.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Observation"/>
  </owl:Class>

  <!-- Medição digital (especialização de medição) -->
  <owl:Class rdf:about="&tinilau;TL_Digital_Measurement_Event">
    <rdfs:label>TL_Digital_Measurement_Event</rdfs:label>
    <rdfs:comment>Medição realizada por dispositivo digital que pode gerar um objeto digital como saída.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Measurement"/>
  </owl:Class>

  <!-- Atribuição/criação de identificadores -->
  <owl:Class rdf:about="&tinilau;TL_Identifier_Assignment">
    <rdfs:label>TL_Identifier_Assignment</rdfs:label>
    <rdfs:comment>Atividade que atribui ou compõe um identificador para uma entidade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attribute_Assignment"/>
  </owl:Class>

  <!-- Atribuições estatísticas globais de desembarque -->
  <owl:Class rdf:about="&tinilau;TL_Global_Statistic_Landing">
    <rdfs:label>TL_Global_Statistic_Landing</rdfs:label>
    <rdfs:comment>Registro/atribuição de indicadores agregados de desembarque em escala global.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attribute_Assignment"/>
  </owl:Class>

  <!-- Período/atividade de uso de um nome/appellation -->
  <owl:Class rdf:about="&tinilau;TL_Name_Use_Activity">
    <rdfs:label>TL_Name_Use_Activity</rdfs:label>
    <rdfs:comment>Período contínuo em que uma denominação específica é usada para uma entidade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attribute_Assignment"/>
  </owl:Class>

  <!-- Execução de software/tarefa computacional -->
  <owl:Class rdf:about="&tinilau;TL_Software_Execution">
    <rdfs:label>TL_Software_Execution</rdfs:label>
    <rdfs:comment>Execução de um programa ou procedimento computacional sobre um conteúdo digital.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Activity"/>
  </owl:Class>

  <!-- Atividade de captura/coleta (ex.: amostragem, pesca) -->
  <owl:Class rdf:about="&tinilau;TL_Capture_Activity">
    <rdfs:label>TL_Capture_Activity</rdfs:label>
    <rdfs:comment>Atividade voltada à captura/detecção/coleta de itens de interesse.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Activity"/>
  </owl:Class>

  <!-- Formação de um estoque/população -->
  <owl:Class rdf:about="&tinilau;TL_Stock_Formation">
    <rdfs:label>TL_Stock_Formation</rdfs:label>
    <rdfs:comment>Evento que estabelece a existência de um estoque/população com membros identificáveis.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Activity"/>
  </owl:Class>

  <!-- Remoção de matéria/indivíduos de um estoque -->
  <owl:Class rdf:about="&tinilau;TL_Matter_Removal">
    <rdfs:label>TL_Matter_Removal</rdfs:label>
    <rdfs:comment>Atividade que remove uma quantidade de matéria/indivíduos de um estoque.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Activity"/>
  </owl:Class>

  <!--
    Subclasses de TL_Property: estruturas para representar atributos e avaliações.
  -->
  <owl:Class rdf:about="&tinilau;TL_Time_Span">
    <rdfs:label>TL_Time_Span</rdfs:label>
    <rdfs:comment>Intervalo de tempo (início, fim, duração).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Property"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Dimension">
    <rdfs:label>TL_Dimension</rdfs:label>
    <rdfs:comment>Dimensão mensurável (p.ex. distância, peso, tempo).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Property"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_SpaceTime_Volume">
    <rdfs:label>TL_SpaceTime_Volume</rdfs:label>
    <rdfs:comment>Volume espaço-temporal (ocupação de um processo no espaço e tempo).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Property"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Evaluation">
    <rdfs:label>TL_Evaluation</rdfs:label>
    <rdfs:comment>Avaliação ou escala (qualitativa ou quantitativa).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Property"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Status">
    <rdfs:label>TL_Status</rdfs:label>
    <rdfs:comment>Estado ou condição de uma entidade ou processo (operacional, degradado).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Property"/>
  </owl:Class>

    <!-- ============================== -->
  <!-- TINILAU — Security (Classes)   -->
  <!-- ============================== -->

  <!-- Papel/entidade-alvo (físico, digital, informacional, humano) -->
  <owl:Class rdf:about="&tinilau;TL_Target">
    <rdfs:label>TL_Target</rdfs:label>
    <rdfs:comment>Entidade que pode ser afetada por ameaça/ataque (papel conceitual de alvo).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Ameaça (intenção/possibilidade hostil) -->
  <owl:Class rdf:about="&tinilau;TL_Threat">
    <rdfs:label>TL_Threat</rdfs:label>
    <rdfs:comment>Existência de intenção hostil ou possibilidade concreta de ataque.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Ataque (ação hostil concreta) -->
  <owl:Class rdf:about="&tinilau;TL_Attack">
    <rdfs:label>TL_Attack</rdfs:label>
    <rdfs:comment>Ação maliciosa que visa comprometer/degradar ativos físicos ou digitais.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Event"/>
  </owl:Class>

  <!-- Ator/grupo malicioso -->
  <owl:Class rdf:about="&tinilau;TL_Threat_Actor">
    <rdfs:label>TL_Threat_Actor</rdfs:label>
    <rdfs:comment>Agente malicioso ou grupo (intrusion set) envolvido em ameaças/ataques.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Agent"/>
  </owl:Class>

  <!-- Padrão/técnica (conceitual) -->
  <owl:Class rdf:about="&tinilau;TL_Attack_Pattern">
    <rdfs:label>TL_Attack_Pattern</rdfs:label>
    <rdfs:comment>Padrão/técnica de ataque (conceito reutilizável; p.ex., ATT&amp;CK).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Event_Type"/>
  </owl:Class>

  <!-- Ferramenta de ataque (malware/toolkit/script) -->
  <owl:Class rdf:about="&tinilau;TL_Attack_Tool">
    <rdfs:label>TL_Attack_Tool</rdfs:label>
    <rdfs:comment>Ferramenta empregada em ataques (malware, exploit, toolkit, script).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Software"/>
  </owl:Class>

  <!-- Ativo digital/infra TI (alvo típico) -->
  <owl:Class rdf:about="&tinilau;TL_IT_System">
    <rdfs:label>TL_IT_System</rdfs:label>
    <rdfs:comment>Sistema/plataforma de TI (bordo ou terra) sujeito a ciberataques.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Artifact"/>
  </owl:Class>

  <!-- Vulnerabilidade (conceitual; inclui CVE, má configuração, fraqueza de processo) -->
  <owl:Class rdf:about="&tinilau;TL_Vulnerability">
    <rdfs:label>TL_Vulnerability</rdfs:label>
    <rdfs:comment>Fraqueza explorável em sistemas, dispositivos ou processos.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Incidente cibernético (ocorrência concreta) -->
  <owl:Class rdf:about="&tinilau;TL_Cyber_Incident">
    <rdfs:label>TL_Cyber_Incident</rdfs:label>
    <rdfs:comment>Ocorrência de segurança (intrusão, malware, DDoS, spoofing AIS, ransomware etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Event"/>
  </owl:Class>

  <!-- Impacto (segurança da informação) -->
  <owl:Class rdf:about="&tinilau;TL_Security_Impact">
    <rdfs:label>TL_Security_Impact</rdfs:label>
    <rdfs:comment>Impacto em confidencialidade, integridade, disponibilidade e/ou privacidade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Evaluation"/>
  </owl:Class>

  
  <!-- SAFETY (não intencional) -->
  <owl:Class rdf:about="&tinilau;TL_Safety_Event">
    <rdfs:label>TL_Safety_Event</rdfs:label>
    <rdfs:comment>
      Evento de falha não intencional (erro humano, pane, acidente operacional).
    </rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Event"/>
  </owl:Class>

  <!-- Impacto (safety/operacional) -->
  <owl:Class rdf:about="&tinilau;TL_Safety_Impact">
    <rdfs:label>TL_Safety_Impact</rdfs:label>
    <rdfs:comment>Impacto à segurança física/operacional (pessoas, embarcações, infraestrutura).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Evaluation"/>
  </owl:Class>

  <!-- Risco cibernético (avaliação preditiva) -->
  <owl:Class rdf:about="&tinilau;TL_Cyber_Risk">
    <rdfs:label>TL_Cyber_Risk</rdfs:label>
    <rdfs:comment>Avaliação de risco combinando ameaça, vulnerabilidade e impacto potencial.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Evaluation"/>
  </owl:Class>

  <!-- Contramedida (curso de ação/procedimento) -->
  <owl:Class rdf:about="&tinilau;TL_Countermeasure">
    <rdfs:label>TL_Countermeasure</rdfs:label>
    <rdfs:comment>Medida preventiva/detectiva/corretiva/dissuassória para reduzir risco/impacto.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Design_or_Procedure_Type"/>
  </owl:Class>

  <!-- ========================================== -->
  <!-- TINILAU — Security (Somente Subclasses)    -->
  <!-- ========================================== -->

  <!-- ===== Targets (papéis de alvo) ===== -->
  <owl:Class rdf:about="&tinilau;TL_Physical_Target">
    <rdfs:label>TL_Physical_Target</rdfs:label>
    <rdfs:comment>Alvos físicos (ex.: embarcações, instalações portuárias).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Target"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Human_Target">
    <rdfs:label>TL_Human_Target</rdfs:label>
    <rdfs:comment>Alvos humanos (ex.: perfis profissionais portuários).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Target"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Informational_Target">
    <rdfs:label>TL_Informational_Target</rdfs:label>
    <rdfs:comment>Alvos informacionais (ex.: dados/mensagens AIS, relatórios).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Target"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_System_Target">
    <rdfs:label>TL_System_Target</rdfs:label>
    <rdfs:comment>Alvos de sistemas (ex.: VTS, TOS, infra de TI portuária).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Target"/>
  </owl:Class>


  <!-- ===== IT Systems (alvos típicos) ===== -->
  <owl:Class rdf:about="&tinilau;TL_Port_IT_System">
    <rdfs:label>TL_Port_IT_System</rdfs:label>
    <rdfs:comment>Sistemas de TI do porto (TOS, SOC, ERP/SCADA correlatos).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_IT_System"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_VTS_System">
    <rdfs:label>TL_VTS_System</rdfs:label>
    <rdfs:comment>Vessel Traffic Service (controle de tráfego de embarcações).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_IT_System"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_AIS_Infrastructure">
    <rdfs:label>TL_AIS_Infrastructure</rdfs:label>
    <rdfs:comment>Infraestrutura AIS (estações costeiras/serviços de processamento).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_IT_System"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Port_Community_System">
  <rdfs:label>TL_Port_Community_System</rdfs:label>
  <rdfs:comment>Plataforma PCS para troca documental/aduaneira e agendamento.</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_IT_System"/>
</owl:Class>

<owl:Class rdf:about="&tinilau;TL_Terminal_Operating_System">
  <rdfs:label>TL_Terminal_Operating_System</rdfs:label>
  <rdfs:comment>Sistema de operação de terminal (planejamento, pátio, guindastes).</rdfs:comment>
  <rdfs:subClassOf rdf:resource="&tinilau;TL_IT_System"/>
</owl:Class>


  <!-- ===== Vulnerabilities (tipos) ===== -->
  <owl:Class rdf:about="&tinilau;TL_Design_Weakness">
    <rdfs:label>TL_Design_Weakness</rdfs:label>
    <rdfs:comment>Fraqueza de projeto (ex.: sem segmentação de rede).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vulnerability"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Implementation_Weakness">
    <rdfs:label>TL_Implementation_Weakness</rdfs:label>
    <rdfs:comment>Fraqueza de implementação/código (bugs, validação deficiente).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vulnerability"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Configuration_Weakness">
    <rdfs:label>TL_Configuration_Weakness</rdfs:label>
    <rdfs:comment>Má configuração (portas expostas, credenciais fracas).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vulnerability"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Operational_Weakness">
    <rdfs:label>TL_Operational_Weakness</rdfs:label>
    <rdfs:comment>Fraqueza operacional/processual (procedimentos/treinamento).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vulnerability"/>
  </owl:Class>

  <!-- ===== Attack Pattern (exemplos) ===== -->
  <owl:Class rdf:about="&tinilau;TL_Ransomware">
    <rdfs:label>TL_Ransomware</rdfs:label>
    <rdfs:comment>Padrão/técnica de sequestro de dados/sistemas.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Phishing">
    <rdfs:label>TL_Phishing</rdfs:label>
    <rdfs:comment>Engenharia social para obtenção de acesso/dados.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_AIS_Spoofing">
    <rdfs:label>TL_AIS_Spoofing</rdfs:label>
    <rdfs:comment>Falsificação/manipulação de mensagens AIS.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_DDoS">
    <rdfs:label>TL_DDoS</rdfs:label>
    <rdfs:comment>Negação de serviço distribuída.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:Class>

  <!-- ===== Attack GNSS (exemplos) ===== -->

  <owl:Class rdf:about="&tinilau;TL_GNSS_Spoofing">
    <rdfs:label>TL_GNSS_Spoofing</rdfs:label>
    <rdfs:comment>Falsificação de sinal GNSS para deslocar posição/rota.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_GNSS_Jamming">
    <rdfs:label>TL_GNSS_Jamming</rdfs:label>
    <rdfs:comment>Bloqueio/interferência de GNSS.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_GNSS_Spoofing_Incident">
    <rdfs:label>TL_GNSS_Spoofing_Incident</rdfs:label>
    <rdfs:comment>Ocorrência concreta de spoofing GNSS em ativo/rota/porto.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cyber_Incident"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_GNSS_Jamming_Incident">
    <rdfs:label>TL_GNSS_Jamming_Incident</rdfs:label>
    <rdfs:comment>Ocorrência concreta de jamming GNSS.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Cyber_Incident"/>
</owl:Class>


  <!-- ===== Macro-categorias táticas de ataque ===== -->
  <owl:Class rdf:about="&tinilau;TL_Initial_Access_Attack">
