    <rdfs:comment>Categoria taxonômica de Subfilo.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_SuperClass_Type">
