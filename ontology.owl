    <rdfs:comment>Categoria taxonômica de Filo.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_SubPhylum_Type">
