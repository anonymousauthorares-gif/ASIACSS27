    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_SubClass_Type">
    <rdfs:label>TL_SubClass_Type</rdfs:label>
    <rdfs:comment>Categoria taxonômica de Subclasse.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Biotic_Element_Type"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Order_Type">
    <rdfs:label>TL_Order_Type</rdfs:label>
