<?xml version="1.0" encoding="UTF-8"?>
<!--
  TINILAU ontology — independent version

  This file defines the core classes of the TINILAU ontology. 
  Please adjust the xml:base and ontology IRI to your preferred domain
  before using in a production environment.
-->

<!DOCTYPE rdf:RDF [
  <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
  <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
  <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
  <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
  <!ENTITY dcterms "http://purl.org/dc/terms/" >
  <!ENTITY tinilau "https://w3id.org/tinilau/ont#" >
  <!ENTITY skos "http://www.w3.org/2004/02/skos/core#" >
  <!ENTITY mitre "https://attack.mitre.org/techniques/" >
  <!ENTITY stix "https://oasis-open.github.io/cti-documentation/stix/" >

]>

<rdf:RDF
    xml:base="https://w3id.org/tinilau/ont"
    xmlns:tinilau="https://w3id.org/tinilau/ont#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:dcterms="http://purl.org/dc/terms/">




  <!-- ================================================================== -->
  <!-- Ontology definition                                                 -->
  <!-- ================================================================== -->
  <owl:Ontology rdf:about="https://w3id.org/tinilau/ont">

    <!-- Título e resumo (em dois idiomas é opcional, mas ajuda) -->
    <dcterms:title xml:lang="en">TINILAU Ontology</dcterms:title>
    <dcterms:title xml:lang="pt-BR">Ontologia TINILAU</dcterms:title>

    <dcterms:description xml:lang="en">
      Modular ontology for maritime operations, cybersecurity, autonomy (MASS), and compliance.
    </dcterms:description>
    <dcterms:description xml:lang="pt-BR">
      Ontologia modular para operações marítimas, cibersegurança, autonomia (MASS) e conformidade.
    </dcterms:description>

    <!-- Versão humana e IRI da versão -->
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/tinilau/ont/0.1.0"/>

    <!-- Datas (ISO 8601) -->
    <dcterms:issued   rdf:datatype="&xsd;date">2025-10-08</dcterms:issued>
    <dcterms:modified rdf:datatype="&xsd;date">2025-10-08</dcterms:modified>

    <!-- Autores/Instituição -->
    <dcterms:creator>...</dcterms:creator>
    <dcterms:creator>... </dcterms:creator>
    <dcterms:creator>... </dcterms:creator>
    <dcterms:publisher>...</dcterms:publisher>

    <!-- Idiomas principais do conteúdo/rotulagem -->
    <dcterms:language>en</dcterms:language>

    <!-- Licença (URL oficial) -->
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:rights xml:lang="en">© 2025 TINILAU team - CC BY 4.0.</dcterms:rights>

  </owl:Ontology>


  <!--
    Classes de nível superior: estas cinco raízes subdividem o universo
    de discurso. Elas estendem owl:Thing e são pais de outros módulos.
  -->
  <owl:Class rdf:about="&tinilau;TL_ConceptualType">
    <rdfs:label>TL_ConceptualType</rdfs:label>
    <rdfs:comment>Tipo conceitual abstrato: representa classes e categorias de objetos, eventos, etc.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&owl;Thing"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_InformationResource">
    <rdfs:label>TL_InformationResource</rdfs:label>
    <rdfs:comment>Recursos informacionais: documentos, conjuntos de dados, normas e artefatos digitais.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&owl;Thing"/>
  </owl:Class>

  <!-- ====== Appellations / Expressões linguísticas ====== -->
  <owl:Class rdf:about="&tinilau;TL_Appellation">
    <rdfs:label>TL_Appellation</rdfs:label>
    <rdfs:comment>Designação linguística que nomeia/identifica uma entidade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Linguistic_Object"/>
  </owl:Class>

  <!-- mover TL_Title para ser subclasse de TL_Appellation -->
  <owl:Class rdf:about="&tinilau;TL_Title">
    <rdfs:label>TL_Title</rdfs:label>
    <rdfs:comment>Título textual de um recurso.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Appellation"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Identifier">
    <rdfs:label>TL_Identifier</rdfs:label>
    <rdfs:comment>Identificador (código, número, URI) usado para referir uma entidade.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Appellation"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Place_Appellation">
    <rdfs:label>TL_Place_Appellation</rdfs:label>
    <rdfs:comment>Denominação que se aplica a um lugar.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Appellation"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Place_Name">
    <rdfs:label>TL_Place_Name</rdfs:label>
    <rdfs:comment>Nome próprio de um lugar (ex.: “Baía de Guanabara”).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Place_Appellation"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Spatial_Coordinate">
    <rdfs:label>TL_Spatial_Coordinate</rdfs:label>
    <rdfs:comment>Coordenada/tupla que exprime posição espacial.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Appellation"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Geometric_Place_Expression">
    <rdfs:label>TL_Geometric_Place_Expression</rdfs:label>
    <rdfs:comment>Expressão geométrica que descreve a extensão de um lugar (polígono, bbox, etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Spatial_Coordinate"/>
  </owl:Class>

  <!-- Conjunto de dados -->
  <owl:Class rdf:about="&tinilau;TL_DataSet">
    <rdfs:label>TL_DataSet</rdfs:label>
    <rdfs:comment>Coleção estruturada de dados digitais.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!-- Objeto digital genérico -->
  <owl:Class rdf:about="&tinilau;TL_Digital_Object">
    <rdfs:label>TL_Digital_Object</rdfs:label>
    <rdfs:comment>Objeto informacional em formato digital (arquivo, registro, mídia).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!-- Objeto linguístico -->
  <owl:Class rdf:about="&tinilau;TL_Linguistic_Object">
    <rdfs:label>TL_Linguistic_Object</rdfs:label>
    <rdfs:comment>Conteúdo expresso em linguagem natural ou formal (texto, frase, corpus linguístico).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>


  <!-- ====== Subclasses de Digital Object ====== -->
  <owl:Class rdf:about="&tinilau;TL_Repository_Object">
    <rdfs:label>TL_Repository_Object</rdfs:label>
    <rdfs:comment>Objeto digital que representa/identifica um item em um repositório.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Object"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Software">
    <rdfs:label>TL_Software</rdfs:label>
    <rdfs:comment>Programa ou pacote executável; artefato informacional digital.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Object"/>
  </owl:Class>

  <!-- Publicação -->
  <owl:Class rdf:about="&tinilau;TL_Publication">
    <rdfs:label>TL_Publication</rdfs:label>
    <rdfs:comment>Obra publicada em meio físico ou digital (artigo, livro, relatório).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!-- Sistema de referência espacial -->
  <owl:Class rdf:about="&tinilau;TL_Spatial_CRS">
    <rdfs:label>TL_Spatial_CRS</rdfs:label>
    <rdfs:comment>Sistema de referência espacial para coordenadas geográficas ou projetadas.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!-- Imagem -->
  <owl:Class rdf:about="&tinilau;TL_Image">
    <rdfs:label>TL_Image</rdfs:label>
    <rdfs:comment>Representação visual estática (fotografia, satélite, mapa raster).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!-- Base de dados -->
  <owl:Class rdf:about="&tinilau;TL_Database">
    <rdfs:label>TL_Database</rdfs:label>
    <rdfs:comment>Sistema de gerenciamento de coleções de dados inter-relacionados.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <!-- Direito/licença -->
  <owl:Class rdf:about="&tinilau;TL_Right">
    <rdfs:label>TL_Right</rdfs:label>
    <rdfs:comment>Direito ou licença que regula o uso de recursos de informação.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_PhysicalEntity">
    <rdfs:label>TL_PhysicalEntity</rdfs:label>
    <rdfs:comment>Entidades físicas: objetos materiais, lugares e agentes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&owl;Thing"/>
  </owl:Class>

  <!-- Coleção de entidades físicas -->
  <owl:Class rdf:about="&tinilau;TL_PhysicalCollection">
    <rdfs:label>TL_PhysicalCollection</rdfs:label>
    <rdfs:comment>Conjunto organizado de espécimes ou artefatos físicos preservados como grupo.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Process">
    <rdfs:label>TL_Process</rdfs:label>
    <rdfs:comment>Processos e eventos: atividades, eventos pontuais e medições.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&owl;Thing"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Property">
    <rdfs:label>TL_Property</rdfs:label>
    <rdfs:comment>Propriedades e atributos: dimensões, avaliações, estados.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&owl;Thing"/>
  </owl:Class>

  <!--
    Subclasses de TL_ConceptualType: categorias para tipologias de eventos, objetos e propriedades.
  -->
  <owl:Class rdf:about="&tinilau;TL_Event_Type">
    <rdfs:label>TL_Event_Type</rdfs:label>
    <rdfs:comment>Categoria de eventos (conceito abstrato).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_ConceptualType"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Persistent_Type">
    <rdfs:label>TL_Persistent_Type</rdfs:label>
    <rdfs:comment>Categoria para tipos de entidades persistentes (coisas físicas, agentes).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_ConceptualType"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Conceptual_Object_Type">
    <rdfs:label>TL_Conceptual_Object_Type</rdfs:label>
    <rdfs:comment>Tipos de objetos conceituais (documentos, softwares, normas).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_ConceptualType"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Property_Type">
    <rdfs:label>TL_Property_Type</rdfs:label>
    <rdfs:comment>Tipo de propriedade (atributos medidos ou avaliados).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_ConceptualType"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Physical_Thing_Type">
    <rdfs:label>TL_Physical_Thing_Type</rdfs:label>
    <rdfs:comment>Tipo de entidade física (categorias de lugares, artefatos, agentes).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_ConceptualType"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_Vessel">
    <rdfs:label>TL_Vessel</rdfs:label>
    <rdfs:comment>Maritime vessel (ship, boat, etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Artifact"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_PositionProvider">
    <rdfs:label>TL_PositionProvider</rdfs:label>
    <rdfs:comment>Entity or system that produced the AIS positional information.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_NavigationalStatus">
    <rdfs:label>TL_NavigationalStatus</rdfs:label>
    <rdfs:comment>Navigational status of a vessel as defined in AIS (under way, at anchor, etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Status"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_VesselName">
    <rdfs:label>TL_VesselName</rdfs:label>
    <rdfs:comment>Name of the vessel as used in AIS static data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Appellation"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_PositionEvent">
    <rdfs:label>TL_PositionEvent</rdfs:label>
    <rdfs:comment>
      AIS position event for a vessel, representing a single positional report
      (time, coordinates, kinematic features, and associated metadata).
    </rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Digital_Measurement_Event"/>
  </owl:Class>

<owl:Class rdf:about="&tinilau;FishingVessel">
    <rdfs:label>Fishing Vessel</rdfs:label>
    <rdfs:comment>Vessel used for catching fish.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vessel"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;CargoVessel">
    <rdfs:label>Cargo Vessel</rdfs:label>
    <rdfs:comment>Vessel designed to carry goods.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vessel"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;Tanker">
    <rdfs:label>Tanker</rdfs:label>
    <rdfs:comment>Vessel designed to transport liquids or gases in bulk.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_CargoVessel"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;PassengerVessel">
    <rdfs:label>Passenger Vessel</rdfs:label>
    <rdfs:comment>Vessel designed to carry passengers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vessel"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;HighSpeedCraft">
    <rdfs:label>High Speed Craft</rdfs:label>
    <rdfs:comment>High speed vessel (HSC).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vessel"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;Tug">
    <rdfs:label>Tug</rdfs:label>
    <rdfs:comment>Tugboat used to maneuver other vessels.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Vessel"/>
  </owl:Class>

  <!-- Dataproperties AIS vessel -->

  <owl:DatatypeProperty rdf:about="&tinilau;hasMMSI">
    <rdfs:label>MMSI</rdfs:label>
    <rdfs:comment>Maritime Mobile Service Identity of a vessel.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range rdf:resource="&xsd;integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasMID">
      <rdfs:label>MID</rdfs:label>
      <rdfs:comment>Maritime Identification Digit identifying the vessel registration authority.</rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://fr.wikipedia.org/wiki/Maritime_Mobile_Service_Identity#MID_(Maritime_Identification_Digit)"/>
      <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
      <rdfs:range rdf:resource="&xsd;integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasPositionInstant">
      <rdfs:label>Position Instant</rdfs:label>
      <rdfs:comment>Time instant when the vessel AIS position was recorded.</rdfs:comment>
      <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
      <rdfs:range rdf:resource="&xsd;dateTime"/>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="&tinilau;TL_ExactEarthProvider">
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PositionProvider"/>
    <rdfs:label>TL_ExactEarthProvider</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_SpireProvider">
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PositionProvider"/>
    <rdfs:label>TL_SpireProvider</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_MarineTrafficProvider">
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PositionProvider"/>
    <rdfs:label>TL_MarineTrafficProvider</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_DatalasticProvider">
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PositionProvider"/>
    <rdfs:label>TL_DatalasticProvider</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_UnseenLabsProvider">
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PositionProvider"/>
    <rdfs:label>TL_UnseenLabsProvider</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_UnknownAISProvider">
    <rdfs:subClassOf rdf:resource="&tinilau;TL_PositionProvider"/>
    <rdfs:label>TL_UnknownAISProvider</rdfs:label>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="&tinilau;hasLatitude">
    <rdfs:label>has latitude</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;double"/>
    <rdfs:comment>Latitude of the AIS position in WGS84 format.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasLongitude">
    <rdfs:label>has longitude</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;double"/>
    <rdfs:comment>Longitude of the AIS position in WGS84 format.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasStaticInstant">
    <rdfs:label>has static AIS instant</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range rdf:resource="&xsd;dateTime"/>
    <rdfs:comment>The timestamp (UTC) when the vessel's static AIS data was sent.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasProviderInsertInstant">
    <rdfs:label>provider insert instant</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;dateTime"/>
    <rdfs:comment>
      Timestamp when the AIS message was stored in the provider database.
    </rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasSpeedKnots">
    <rdfs:label>has speed (knots)</rdfs:label>
    <rdfs:comment>Instantaneous speed over ground in knots from AIS.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasCourseOverGroundDeg">
    <rdfs:label>has course over ground (deg)</rdfs:label>
    <rdfs:comment>Course over ground in degrees, as reported by AIS.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasRateOfTurnDegPerMin">
    <rdfs:label>has rate of turn (deg/min)</rdfs:label>
    <rdfs:comment>Rate of turn in degrees per minute, decoded from AIS ROT.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasHeadingDeg">
    <rdfs:label>has heading (deg)</rdfs:label>
    <rdfs:comment>Vessel heading in degrees, as reported by AIS.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasDraughtMeters">
    <rdfs:label>has draught (m)</rdfs:label>
    <rdfs:comment>Vessel draught in meters as reported in AIS static data.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasIMONumber">
    <rdfs:label>has IMO number</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range  rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasCallSignLiteral">
    <rdfs:label>has call sign literal</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range  rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasVesselTypeCode">
    <rdfs:label>has vessel type code</rdfs:label>
    <rdfs:comment>Numeric AIS vessel type code (0–99).</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range  rdf:resource="&xsd;integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasDeltaTimeMs">
    <rdfs:label>has delta time (ms)</rdfs:label>
    <rdfs:comment>
      Time difference in milliseconds between this PositionEvent and the previous one for the same vessel.
    </rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;long"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasSpeedMS">
    <rdfs:label>has speed (m/s)</rdfs:label>
    <rdfs:comment>
      Vessel speed in meters per second derived from consecutive PositionEvents.
    </rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasSpeed">
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>


  <owl:DatatypeProperty rdf:about="&tinilau;hasAccelerationMS2">
    <rdfs:label>has acceleration (m/s²)</rdfs:label>
    <rdfs:comment>
      Linear acceleration in meters per second squared derived from consecutive PositionEvents.
    </rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasKinematicHeadingDeg">
    <rdfs:label>has kinematic heading (deg)</rdfs:label>
    <rdfs:comment>
      Heading in degrees derived or smoothed using previous PositionEvents, distinct from raw AIS heading.
    </rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasRateOfTurnDegPerSec">
    <rdfs:label>has rate of turn (deg/s)</rdfs:label>
    <rdfs:comment>
      Rate of turn in degrees per second derived from consecutive headings and timestamps.
    </rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;isStopped">
    <rdfs:label>is stopped</rdfs:label>
    <rdfs:comment>True if the vessel is considered stopped at this PositionEvent.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasStopGroup">
    <rdfs:label>has stop group</rdfs:label>
    <rdfs:comment>
      Identifier of the stop cluster the PositionEvent belongs to. Same group = same stop period.
    </rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;integer"/>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="&tinilau;TL_StaticProvider">
    <rdfs:label>TL_StaticAISProvider</rdfs:label>
    <rdfs:comment>Entity responsible for providing static AIS metadata.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_InformationResource"/>
  </owl:Class>

  <owl:Class rdf:about="&tinilau;TL_CollectionType">
    <rdfs:label>TL_CollectionType</rdfs:label>
    <rdfs:comment>How the AIS position was collected (terrestrial, satellite, vessel, unknown).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Conceptual_Object_Type"/>
  </owl:Class>

  <!-- Comprimento do navio -->
  <owl:DatatypeProperty rdf:about="&tinilau;hasVesselLengthMeters">
    <rdfs:label>has vessel length (m)</rdfs:label>
    <rdfs:comment>Overall vessel length in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <!-- Boca (largura) do navio -->
  <owl:DatatypeProperty rdf:about="&tinilau;hasVesselWidthMeters">
    <rdfs:label>has vessel width (m)</rdfs:label>
    <rdfs:comment>Vessel beam/width in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range rdf:resource="&xsd;double"/>
  </owl:DatatypeProperty>

  <!-- Destino reportado na mensagem AIS -->
  <owl:DatatypeProperty rdf:about="&tinilau;hasDestinationLiteral">
    <rdfs:label>has destination (literal)</rdfs:label>
    <rdfs:comment>Free-text destination field from AIS message.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <!-- ETA para o destino -->
  <owl:DatatypeProperty rdf:about="&tinilau;hasDestinationETA">
    <rdfs:label>has destination ETA</rdfs:label>
    <rdfs:comment>ETA to destination reported in AIS message.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&xsd;dateTime"/>
  </owl:DatatypeProperty>


  <!-- Properties vessel AIS -->

  <owl:ObjectProperty rdf:about="&tinilau;hasPositionProvider">
    <rdfs:label>has position provider</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&tinilau;TL_PositionProvider"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasStaticProvider">
    <rdfs:label>has static provider</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range rdf:resource="&tinilau;TL_StaticProvider"/>
    <rdfs:comment>Provider of AIS static data of the vessel.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasCollectionType">
    <rdfs:label>has collection type</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range rdf:resource="&tinilau;TL_CollectionType"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasNavigationalStatus">
    <rdfs:label>has navigational status</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&tinilau;TL_NavigationalStatus"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="&tinilau;hasNavigationalStatusCode">
    <rdfs:label>has navigational status code</rdfs:label>
    <rdfs:comment>Numeric AIS navigational status code (0–15).</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PositionEvent"/>
    <rdfs:range  rdf:resource="&xsd;integer"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasVesselName">
    <rdfs:label>has vessel name</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Vessel"/>
    <rdfs:range  rdf:resource="&tinilau;TL_VesselName"/>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasAppellation"/>
  </owl:ObjectProperty>


  <!-- ====================================== -->
  <!-- EXTERNAL ALIGNMENT: MITRE & STIX -->
  <!-- ====================================== -->

  <!-- MITRE ATT&CK Technique T1486 -->
  <owl:NamedIndividual rdf:about="https://attack.mitre.org/techniques/T1486/">
    <rdf:type rdf:resource="&skos;Concept"/>
    <rdfs:label xml:lang="en">T1486 – Data Encrypted for Impact</rdfs:label>
    <skos:closeMatch rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://attack.mitre.org/techniques/T1556/">
    <rdf:type rdf:resource="&skos;Concept"/>
    <rdfs:label xml:lang="en">T1556 – Modify Authentication Process</rdfs:label>
    <skos:closeMatch rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:NamedIndividual>


  <!-- STIX Threat Actor APT28 -->
  <owl:NamedIndividual rdf:about="https://cti.example.com/stix/identity--apt28">
    <rdf:type rdf:resource="&tinilau;TL_Threat_Actor"/>
    <rdfs:label xml:lang="en">APT28</rdfs:label>
    <skos:closeMatch rdf:resource="https://attack.mitre.org/groups/G0007"/>
  </owl:NamedIndividual>

  <!-- STIX Malware Wannacry -->
  <owl:NamedIndividual rdf:about="https://cti.example.com/stix/malware--wannacry">
    <rdf:type rdf:resource="&tinilau;TL_Attack_Tool"/>
    <rdfs:label xml:lang="en">WannaCry Ransomware</rdfs:label>
    <skos:closeMatch rdf:resource="https://attack.mitre.org/software/S0366"/>
  </owl:NamedIndividual>


  <!-- Tipo de Agente (ator persistente) -->
  <owl:Class rdf:about="&tinilau;TL_Actor_Type">
    <rdfs:label>TL_Actor_Type</rdfs:label>
    <rdfs:comment>
      Categoria persistente para agentes (humanos, organizações, grupos), 
      representando o papel/tipo que exercem no domínio marítimo.
    </rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Persistent_Type"/>
  </owl:Class>

  <!-- Tipo de elemento biótico -->
  <owl:Class rdf:about="&tinilau;TL_Biotic_Element_Type">
    <rdfs:label>TL_Biotic_Element_Type</rdfs:label>
    <rdfs:comment>Categoria de seres vivos ou componentes biológicos (ex.: peixe, planta marinha).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Physical_Thing_Type"/>
  </owl:Class>

  <!-- Tipo de equipamento -->
  <owl:Class rdf:about="&tinilau;TL_Equipment_Type">
    <rdfs:label>TL_Equipment_Type</rdfs:label>
    <rdfs:comment>Categoria de equipamentos e dispositivos usados em atividades marítimas.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Physical_Thing_Type"/>
  </owl:Class>

  <!-- Tipo de elemento abiótico -->
  <owl:Class rdf:about="&tinilau;TL_Abiotic_Element_Type">
    <rdfs:label>TL_Abiotic_Element_Type</rdfs:label>
    <rdfs:comment>Categoria de componentes físicos não vivos (ex.: gelo, areia, recifes rochosos).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="&tinilau;TL_Physical_Thing_Type"/>
  </owl:Class>

  <!-- Classificação taxonômica de elementos bióticos -->

  <owl:Class rdf:about="&tinilau;TL_Kingdom_Type">
