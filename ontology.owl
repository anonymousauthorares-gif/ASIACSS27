  <!-- ===================== -->
  <!-- Disjointness axioms   -->
  <!-- ===================== -->
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&tinilau;TL_PhysicalEntity"/>
      <rdf:Description rdf:about="&tinilau;TL_Process"/>
      <rdf:Description rdf:about="&tinilau;TL_InformationResource"/>
      <rdf:Description rdf:about="&tinilau;TL_Property"/>
      <rdf:Description rdf:about="&tinilau;TL_ConceptualType"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- ===================== -->
  <!-- Disjointness: Physical branches -->
  <!-- ===================== -->
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&tinilau;TL_Place"/>
      <rdf:Description rdf:about="&tinilau;TL_Physical_Object"/>
      <rdf:Description rdf:about="&tinilau;TL_Amount_of_Matter"/>
      <rdf:Description rdf:about="&tinilau;TL_Agent"/>
      <rdf:Description rdf:about="&tinilau;TL_Ecosystem"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <!-- Disjointness: living vs non-living (object level) -->
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&tinilau;TL_Biological_Object"/>
      <rdf:Description rdf:about="&tinilau;TL_Abiotic_Element"/>
    </owl:members>
  </owl:AllDisjointClasses>
  

  <!-- Ataque: separar padrão (conceitual), ataque (evento) e incidente (evento concreto) -->
  <!--<owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="&tinilau;TL_Attack_Pattern"/>
      <rdf:Description rdf:about="&tinilau;TL_Attack"/>
      <rdf:Description rdf:about="&tinilau;TL_Cyber_Incident"/>
    </owl:members>
  </owl:AllDisjointClasses>-->


  <!-- OBJECT PROPERTIES -->
  <owl:ObjectProperty rdf:about="&tinilau;partOf">
    <rdfs:label>partOf</rdfs:label>
    <rdfs:comment>Relação parte–todo entre entidades físicas.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PhysicalEntity"/>
    <rdfs:range  rdf:resource="&tinilau;TL_PhysicalEntity"/>
    <rdf:type rdf:resource="&owl;TransitiveProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasPart">
    <rdfs:label>hasPart</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;partOf"/>
    <rdfs:domain rdf:resource="&tinilau;TL_PhysicalEntity"/>
    <rdfs:range  rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:ObjectProperty>

  <!-- Localização de objetos -->
  <owl:ObjectProperty rdf:about="&tinilau;locatedIn">
    <rdfs:label>locatedIn</rdfs:label>
    <rdfs:comment>Objeto físico localizado em um lugar.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PhysicalEntity"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Place"/>
    <rdf:type rdf:resource="&owl;TransitiveProperty"/>
  </owl:ObjectProperty>

  <!-- Local de ocorrência de processos -->
  <owl:ObjectProperty rdf:about="&tinilau;occursAt">
    <rdfs:label>occursAt</rdfs:label>
    <rdfs:comment>Processo/Evento que ocorre em um lugar.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Process"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Place"/>
  </owl:ObjectProperty>

  <!-- Processo tem participante -->
  <owl:ObjectProperty rdf:about="&tinilau;hasParticipant">
    <rdfs:label>hasParticipant</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Process"/>
    <rdfs:range  rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;participatesIn">
    <rdfs:label>participatesIn</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;hasParticipant"/>
    <rdfs:domain rdf:resource="&tinilau;TL_PhysicalEntity"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Process"/>
  </owl:ObjectProperty>

  <!-- TEMPORAL EXTENT -->
  <owl:ObjectProperty rdf:about="&tinilau;hasTimeSpan">
    <rdfs:label>hasTimeSpan</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Process"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Time_Span"/>
  </owl:ObjectProperty>

  <!-- GEOMETRY BINDING -->
  <owl:ObjectProperty rdf:about="&tinilau;hasGeometry">
    <rdfs:label>hasGeometry</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Place"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Geometric_Place_Expression"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasCRS">
    <rdfs:label>hasCRS</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Geometric_Place_Expression"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Spatial_CRS"/>
  </owl:ObjectProperty>

  <!-- APPELLATIONS -->
  <owl:ObjectProperty rdf:about="&tinilau;hasAppellation">
    <rdfs:label>hasAppellation</rdfs:label>
    <rdfs:domain rdf:resource="&owl;Thing"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Appellation"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasTitle">
    <rdfs:label>hasTitle</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasAppellation"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Title"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasIdentifier">
    <rdfs:label>hasIdentifier</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasAppellation"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Identifier"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasPlaceName">
    <rdfs:label>hasPlaceName</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasAppellation"/>
    <rdfs:domain rdf:resource="&tinilau;TL_Place"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Place_Name"/>
  </owl:ObjectProperty>


  <!-- SPECIMEN RELATIONS -->
  <owl:ObjectProperty rdf:about="&tinilau;specimenOf">
    <rdfs:label>specimenOf</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Specimen"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Biological_Object"/>
    <rdf:type rdf:resource="&owl;FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasSpecimen">
    <rdfs:label>hasSpecimen</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;specimenOf"/>
    <rdfs:domain rdf:resource="&tinilau;TL_Biological_Object"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Specimen"/>
  </owl:ObjectProperty>


  <!-- SECURITY: TARGETING -->
  <!-- SECURITY: CANONICAL TARGET -->
  <owl:ObjectProperty rdf:about="&tinilau;hasTarget">
    <rdfs:label>hasTarget</rdfs:label>
    <rdfs:comment>Relates an Attack or Cyber Incident to its Target role.</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Attack"/>
          <rdf:Description rdf:about="&tinilau;TL_Cyber_Incident"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Target"/>
  </owl:ObjectProperty>

  <!-- SECURITY: TARGETING (ajustar a propriedade antiga) -->
  <owl:ObjectProperty rdf:about="&tinilau;targets">
    <rdfs:label>targets</rdfs:label>
    <rdfs:comment>Alias legacy: subproperty of hasTarget for backward compatibility.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasTarget"/>
    <!-- opcional: descomente para deprecar formalmente
    <owl:deprecated rdf:datatype="&xsd;boolean">true</owl:deprecated>
    -->
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Attack"/>
          <rdf:Description rdf:about="&tinilau;TL_Cyber_Incident"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Target"/>
  </owl:ObjectProperty>

  <!-- SECURITY: EXPLOIT -->
  <owl:ObjectProperty rdf:about="&tinilau;exploits">
    <rdfs:label>exploits</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Attack"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Vulnerability"/>
  </owl:ObjectProperty>

  <!-- MASS: DEVICE ↔ FUNCTION -->
  <owl:ObjectProperty rdf:about="&tinilau;implementsFunction">
    <rdfs:label>implementsFunction</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Digital_Device"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Device_Function"/>
  </owl:ObjectProperty>

  <!-- SECURITY: ATTACK PATTERN LINK -->
  <owl:ObjectProperty rdf:about="&tinilau;hasAttackPattern">
    <rdfs:label>hasAttackPattern</rdfs:label>
    <rdfs:comment>Links an Attack or Cyber Incident to the abstract Attack Pattern it instantiates/follows.</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Attack"/>
          <rdf:Description rdf:about="&tinilau;TL_Cyber_Incident"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Attack_Pattern"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;causedSafetyEvent">
    <rdfs:label>causedSafetyEvent</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Cyber_Incident"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Safety_Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;triggeredBySafetyEvent">
    <rdfs:label>triggeredBySafetyEvent</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Cyber_Incident"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Safety_Event"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasSafetyImpact">
    <rdfs:label>hasSafetyImpact</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Event"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Safety_Impact"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasSecurityImpact">
    <rdfs:label>hasSecurityImpact</rdfs:label>
    <rdfs:domain rdf:resource="&tinilau;TL_Event"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Security_Impact"/>
  </owl:ObjectProperty>


  <!-- SECURITY: TOOL USAGE -->
  <owl:ObjectProperty rdf:about="&tinilau;usesTool">
    <rdfs:label>usesTool</rdfs:label>
    <rdfs:comment>Attack or Cyber Incident uses a concrete tool (malware/exploit/toolkit/script).</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Attack"/>
          <rdf:Description rdf:about="&tinilau;TL_Cyber_Incident"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Attack_Tool"/>
  </owl:ObjectProperty>

  <!-- SECURITY: PERPETRATOR -->
  <owl:ObjectProperty rdf:about="&tinilau;perpetratedBy">
    <rdfs:label>perpetratedBy</rdfs:label>
    <rdfs:comment>Attack or Cyber Incident perpetrated by a Threat Actor (individual or group).</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Attack"/>
          <rdf:Description rdf:about="&tinilau;TL_Cyber_Incident"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Threat_Actor"/>
  </owl:ObjectProperty>

  <!-- SECURITY: MITIGATION -->
  <owl:ObjectProperty rdf:about="&tinilau;mitigates">
    <rdfs:label>mitigates</rdfs:label>
    <rdfs:comment>Countermeasure mitigates (reduces likelihood/impact of) a Cyber Incident.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Countermeasure"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Cyber_Incident"/>
  </owl:ObjectProperty>

  <!-- SECURITY: IMPACT LINK -->
  <owl:ObjectProperty rdf:about="&tinilau;hasImpact">
    <rdfs:label>hasImpact</rdfs:label>
    <rdfs:comment>Cyber Incident has an impact (security/safety) assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Cyber_Incident"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Evaluation"/>
  </owl:ObjectProperty>


  <!-- ============================= -->
  <!-- MASS — Object Properties     -->
  <!-- ============================= -->

  <!-- VESSEL / EVENT → AUTONOMY LEVEL -->
  <owl:ObjectProperty rdf:about="&tinilau;hasAutonomyLevel">
    <rdfs:label>hasAutonomyLevel</rdfs:label>
    <rdfs:comment>Assigns an Autonomy Level to a Vessel or to a specific Navigation Event.</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Autonomous_Vessel"/>
          <rdf:Description rdf:about="&tinilau;TL_Autonomous_Navigation_Event"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Autonomy_Level"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isAutonomyLevelOf">
    <rdfs:label>isAutonomyLevelOf</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;hasAutonomyLevel"/>
  </owl:ObjectProperty>

  <!-- VESSEL / EVENT → SUPERVISION MODE -->
  <owl:ObjectProperty rdf:about="&tinilau;hasSupervisionMode">
    <rdfs:label>hasSupervisionMode</rdfs:label>
    <rdfs:comment>Relates a Vessel or Navigation Event to its supervision mode (shore-based / onboard).</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Autonomous_Vessel"/>
          <rdf:Description rdf:about="&tinilau;TL_Autonomous_Navigation_Event"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Supervision_Mode"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isSupervisionModeOf">
    <rdfs:label>isSupervisionModeOf</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;hasSupervisionMode"/>
  </owl:ObjectProperty>

  <!-- EVENT → MISSION OUTCOME -->
  <owl:ObjectProperty rdf:about="&tinilau;hasMissionOutcome">
    <rdfs:label>hasMissionOutcome</rdfs:label>
    <rdfs:comment>Navigation Event outcome (successful/degraded/aborted).</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Autonomous_Navigation_Event"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Mission_Outcome"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isOutcomeOf">
    <rdfs:label>isOutcomeOf</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;hasMissionOutcome"/>
  </owl:ObjectProperty>


  <!-- VESSEL / EVENT → HUMAN ROLE -->
  <owl:ObjectProperty rdf:about="&tinilau;supervisedBy">
    <rdfs:label>supervisedBy</rdfs:label>
    <rdfs:comment>Relates a Vessel or Navigation Event to the human who supervises it.</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="&tinilau;TL_Autonomous_Vessel"/>
          <rdf:Description rdf:about="&tinilau;TL_Autonomous_Navigation_Event"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="&tinilau;TL_Person"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isSupervisorOf">
    <rdfs:label>isSupervisorOf</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;supervisedBy"/>
  </owl:ObjectProperty>

  <!-- papéis especializados ajudam em consultas por tipo -->
  <owl:ObjectProperty rdf:about="&tinilau;operatedByRemoteOperator">
    <rdfs:label>operatedByRemoteOperator</rdfs:label>
    <rdfs:comment>Remote operator related to vessel or event.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="&tinilau;supervisedBy"/>
    <rdfs:range rdf:resource="&tinilau;TL_Remote_Operator"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;supervisedByAutonomySupervisor">
    <rdfs:label>supervisedByAutonomySupervisor</rdfs:label>
    <rdfs:comment>Autonomy supervisor relation.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="&tinilau;supervisedBy"/>
    <rdfs:range rdf:resource="&tinilau;TL_Autonomy_Supervisor"/>
  </owl:ObjectProperty>

  <!-- VESSEL → DEVICE -->
  <owl:ObjectProperty rdf:about="&tinilau;hasDevice">
    <rdfs:label>hasDevice</rdfs:label>
    <rdfs:comment>Vessel carries/hosts a digital device.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_PhysicalEntity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isDeviceOf">
    <rdfs:label>isDeviceOf</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;hasDevice"/>
  </owl:ObjectProperty>

  <!-- VESSEL → FUNCTION (derivada via devices, mas útil para CQs diretas) -->
  <owl:ObjectProperty rdf:about="&tinilau;supportsFunction">
    <rdfs:label>supportsFunction</rdfs:label>
    <rdfs:comment>Vessel supports a function (often via onboard devices/software).</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Autonomous_Vessel"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Device_Function"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isFunctionSupportedBy">
    <rdfs:label>isFunctionSupportedBy</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;supportsFunction"/>
  </owl:ObjectProperty>

  <!-- DEVICE ↔ FUNCTION (você já tem implementsFunction no device) -->
  <owl:ObjectProperty rdf:about="&tinilau;isFunctionImplementedBy">
    <rdfs:label>isFunctionImplementedBy</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;implementsFunction"/>
  </owl:ObjectProperty>

  <!-- VESSEL → AUTONOMY SOFTWARE -->
  <owl:ObjectProperty rdf:about="&tinilau;usesAutonomySoftware">
    <rdfs:label>usesAutonomySoftware</rdfs:label>
    <rdfs:comment>Vessel uses/hosts a piece of autonomy-related software.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Autonomous_Vessel"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Autonomy_Software"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isAutonomySoftwareUsedBy">
    <rdfs:label>isAutonomySoftwareUsedBy</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;usesAutonomySoftware"/>
  </owl:ObjectProperty>

  <!-- EVENT → ENVIRONMENTAL CONDITION (genérica) -->
  <owl:ObjectProperty rdf:about="&tinilau;hasEnvironmentalCondition">
    <rdfs:label>hasEnvironmentalCondition</rdfs:label>
    <rdfs:comment>Relates a navigation event to contextual weather/sea conditions.</rdfs:comment>
    <rdfs:domain rdf:resource="&tinilau;TL_Autonomous_Navigation_Event"/>
    <rdfs:range  rdf:resource="&tinilau;TL_Weather_Condition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;isEnvironmentalConditionOf">
    <rdfs:label>isEnvironmentalConditionOf</rdfs:label>
    <owl:inverseOf rdf:resource="&tinilau;hasEnvironmentalCondition"/>
  </owl:ObjectProperty>

  <!-- Especializações úteis para filtros em CQs -->
  <owl:ObjectProperty rdf:about="&tinilau;hasVisibilityCondition">
    <rdfs:label>hasVisibilityCondition</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasEnvironmentalCondition"/>
    <rdfs:range rdf:resource="&tinilau;TL_Visibility_Condition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasSeaStateCondition">
    <rdfs:label>hasSeaStateCondition</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasEnvironmentalCondition"/>
    <rdfs:range rdf:resource="&tinilau;TL_Sea_State_Condition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasWindCondition">
    <rdfs:label>hasWindCondition</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasEnvironmentalCondition"/>
    <rdfs:range rdf:resource="&tinilau;TL_Wind_Condition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasCurrentCondition">
    <rdfs:label>hasCurrentCondition</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasEnvironmentalCondition"/>
    <rdfs:range rdf:resource="&tinilau;TL_Current_Condition"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&tinilau;hasPrecipitationCondition">
    <rdfs:label>hasPrecipitationCondition</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&tinilau;hasEnvironmentalCondition"/>
    <rdfs:range rdf:resource="&tinilau;TL_Precipitation_Condition"/>
  </owl:ObjectProperty>

  <!-- MITRE ATT&CK Techniques -->

  <owl:NamedIndividual rdf:about="&tinilau;Incident_Port_Santos_2025">
    <rdf:type rdf:resource="&tinilau;TL_Ransomware_Incident"/>
    <tinilau:hasAttackPattern rdf:resource="https://attack.mitre.org/techniques/T1486/"/>
    <tinilau:usesTool rdf:resource="https://cti.example.com/stix/malware--wannacry"/>
    <tinilau:perpetratedBy rdf:resource="https://cti.example.com/stix/identity--apt28"/>
  </owl:NamedIndividual>




</rdf:RDF>
